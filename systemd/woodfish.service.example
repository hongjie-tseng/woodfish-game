[Unit]
Description=Woodfish FastAPI game server
After=network.target

[Service]
Type=simple
User=labuser
WorkingDirectory=/home/labuser/woodfish-game
EnvironmentFile=/home/labuser/woodfish-game/.env
ExecStart=/home/labuser/woodfish-game/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
SyslogIdentifier=woodfish

[Install]
WantedBy=multi-user.target
